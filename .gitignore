# Static SEO guide pages (~9,600 files / 115MB) are GENERATED at deploy time by
# _gen_seo_pages.js (see netlify.toml build command), not committed — keeping
# them in git would bloat every clone and deploy. sitemap.xml IS committed as a
# fallback; the build regenerates it from the current champion data.
matchup/
